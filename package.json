{
	"name": "aiformat",
	"version": "0.2.7",
	"description": "AI Format is a tool that helps you format your code using AI",
	"license": "MIT",
	"bin": "dist/cli.js",
	"type": "module",
	"engines": {
		"node": ">=16"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/farouqaldori/aiformat.git"
	},
	"scripts": {
		"build": "node syncVersion.mjs && tsc",
		"dev": "node syncVersion.mjs && tsc --watch",
		"test": "prettier --check . && xo && ava",
		"format": "prettier --write .",
		"lint": "eslint .",
		"sync-version": "node syncVersion.mjs"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"@npmcli/package-json": "^5.1.1",
		"clipboardy": "^4.0.0",
		"fast-ignore": "^1.1.3",
		"figures": "^6.1.0",
		"ink": "^4.1.0",
		"meow": "^11.0.0",
		"react": "^18.2.0"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^3.0.1",
		"@types/npmcli__package-json": "^4.0.4",
		"@types/react": "^18.0.32",
		"@typescript-eslint/eslint-plugin": "^7.18.0",
		"@typescript-eslint/parser": "^7.18.0",
		"@vdemedes/prettier-config": "^2.0.1",
		"ava": "^5.2.0",
		"chalk": "^5.2.0",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.0",
		"eslint-config-xo-react": "^0.27.0",
		"eslint-plugin-prettier": "^5.2.3",
		"eslint-plugin-react": "^7.37.4",
		"eslint-plugin-react-hooks": "^5.1.0",
		"ink-testing-library": "^3.0.0",
		"prettier": "^3.4.2",
		"ts-node": "^10.9.1",
		"typescript": "^5.0.3",
		"xo": "^0.60.0"
	},
	"ava": {
		"extensions": {
			"ts": "module",
			"tsx": "module"
		},
		"nodeArguments": [
			"--loader=ts-node/esm"
		]
	},
	"xo": {
		"extends": "xo-react",
		"prettier": true,
		"rules": {
			"react/prop-types": "off"
		}
	},
	"prettier": "@vdemedes/prettier-config"
}
